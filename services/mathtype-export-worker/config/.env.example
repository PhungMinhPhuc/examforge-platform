MATHTYPE_MT6_DLL=C:\Program Files (x86)\MathType\System\64\MT6.dll
# 0 = LAUNCH_AS_NEEDED, giữ nguyên MathType Server đã được người dùng mở.
# Chỉ đặt 1 khi worker phải chủ động sở hữu/khởi chạy server cho một lượt riêng.
MATHTYPE_CONNECT_OPTION=0
MATHTYPE_STAGE_TIMEOUT_SECONDS=300
MATHTYPE_WORKER_TIMEOUT_SECONDS=300
MATHTYPE_SERVER_HOST=127.0.0.1
MATHTYPE_SERVER_PORT=18765
# Bắt buộc khi bind ra ngoài loopback hoặc backend Linux gọi Windows worker.
# MATHTYPE_SERVER_TOKEN=replace-with-a-long-random-secret
MATHTYPE_SERVER_MAX_REQUEST_MB=100
# Optional provider overrides. Values must be JSON arrays, not shell strings.
# MATHTYPE_CONVERTER_COMMAND_JSON=["java","-cp","/app/mathtype-export-worker.jar","com.lz.paperword.tools.DocxOmmlToMathTypeConverter"]
# MATHTYPE_NATIVE_RENDERER_COMMAND_JSON=["python","/app/native/export_docx_factory.py"]
